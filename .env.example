# Single-line KEY=value; quote spaces and #. No shell execution or interpolation.
TOPSAP_IMAGE='ghcr.io/karanocave/topsap-vpn-docker:latest'
VPN_HOST='vpn.example.com:443'
VPN_ACCOUNT='your-account'
VPN_PASSWD='your-password'
VPN_TOTP_SECRET='BASE32_AUTHENTICATOR_SEED'
VPN_DNS='10.0.0.53'
VPN_MTU=1280
LOGIN_TIMEOUT=120
LOGIN_FAILURE_LIMIT=3
SOCKS_BIND='127.0.0.1'
SOCKS_PORT=1080
SOCKS_TLS=0
# Public access requires TLS; SERVER_NAME must match the certificate SAN.
# SOCKS_TLS_SERVER_NAME='proxy.example.com'
# SOCKS_TLS_CERT_FILE='runtime/tls/server.crt'
# SOCKS_TLS_KEY_FILE='runtime/tls/server.key'
SOCKS_USERNAME='your-proxy-user'
SOCKS_PASSWORD='replace-with-a-random-password'
HEALTHCHECK_HOST='10.0.0.10'
HEALTHCHECK_PORT=443
DEBUG_DESKTOP=0
